{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "paths": {
      "@components": ["./src/components"],
      "@context": ["./src/contexts"],
      "@constants": ["./src/constants"],
      "@enums": ["./src/enums"],
      "@hooks": ["./src/hooks"],
      "@screens": ["./src/screens"],
      "@navigation": ["./src/navigation"],
      "@store": ["./src/store"],
      "@api": ["./src/api"],
      "@types": ["./src/types"],
      "@assets": ["./src/assets"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods"]
}
